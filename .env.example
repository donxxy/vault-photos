# SQLite is the default (lightweight NAS). For PostgreSQL set provider = "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./vault.db"
# openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
# Where photos live. Each user gets <STORAGE_ROOT>/<username>/YYYY/MM/
STORAGE_ROOT="./storage"
# Set to "false" after your family has created accounts (admins can still add users)
ALLOW_SIGNUP="true"
